# Secrets — never commit. Tokens are read from the environment at run time.
.env
.env.*
!.env.example

# Eval run output: transcripts, debug logs, and reports from every invocation. Large,
# machine-specific, and they can contain whatever your MCP returned.
#
# `.runs/` is what the runner writes to by default — a dot-directory at the invocation cwd,
# like .pytest_cache, rather than nested inside the cases it reports on. `**/runs/` stays as
# a safety net for the old default (`<cases-dir>/runs`), one of which got committed once.
# A custom `--runs-dir` needs its own entry here, or point it outside the repo.
.runs/
**/runs/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# Claude Code local settings (machine-specific permissions, not project config)
.claude/settings.local.json
