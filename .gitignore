# Secrets — tokens come from the environment at run time.
.env
.env.*
!.env.example

# Eval run output. Large, machine-specific, and can contain whatever your MCP returned.
# `**/runs/` covers the pre-.runs default; a custom --runs-dir needs its own entry.
.runs/
**/runs/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# Claude Code local settings, not project config
.claude/settings.local.json
