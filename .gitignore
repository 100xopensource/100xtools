# Secrets — never commit. Tokens are read from the environment at run time.
.env
.env.*
!.env.example

# Eval run output: transcripts, debug logs, and reports from every invocation.
# These are large, machine-specific, and can contain data returned by your own MCP.
# The runner writes <--root>/runs/ and --root is arbitrary (defaults to `evals`,
# but the shipped examples use examples/plugin-eval/cases). Pinning to `evals/`
# let a throwaway run get committed. Match the convention, not one path.
examples/plugin-eval/cases/runs/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# Claude Code local settings (machine-specific permissions, not project config)
.claude/settings.local.json
