# The store service, configured. Copy to `.env`, fill ONE vendor block, delete the rest.
#
# `.env` holds live credentials. It never belongs in a Kit, in a handoff, or in git —
# the emitter and the archive scanner both refuse it by name, and your repo should too.

# ---- Always ------------------------------------------------------------------------
CONTINUITY_BUCKET=
CONTINUITY_PREFIX=continuity
CONTINUITY_DB=./continuity-store.sqlite3
CONTINUITY_TRANSPORT=http
PORT=8787

# How long a minted URL lives. Minutes, not hours: a URL is the whole authorisation.
CONTINUITY_UPLOAD_TTL=600
CONTINUITY_DOWNLOAD_TTL=600

# ---- AWS S3 ---------------------------------------------------------------------------
# No endpoint: boto3 resolves the regional one. Prefer a role or SSO over static keys —
# if you already have `aws sso login` working, leave the two keys blank and drop the
# profile name in instead.
AWS_REGION=us-east-1
# AWS_PROFILE=your-sso-profile
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- Cloudflare R2 --------------------------------------------------------------------
# R2 has no regions; `auto` is the literal value it wants, and the endpoint carries the
# account id. The keys come from an R2 API token, not a global Cloudflare key.
# CONTINUITY_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# AWS_REGION=auto
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---- Backblaze B2 ---------------------------------------------------------------------
# The endpoint's region must match the one in AWS_REGION or signing fails, which B2
# reports as a generic 403 — that mismatch is the usual cause.
# CONTINUITY_S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# AWS_REGION=us-west-004
# AWS_ACCESS_KEY_ID=<keyID>
# AWS_SECRET_ACCESS_KEY=<applicationKey>

# ---- MinIO ------------------------------------------------------------------------------
# Self-hosted. The region is arbitrary but must not be empty, and the endpoint must be
# https from anywhere the plugin runs — a minted http URL is refused, by design.
# CONTINUITY_S3_ENDPOINT=https://minio.example.net
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---- Local only --------------------------------------------------------------------------
# Skips the authentication gate so a single machine can exercise the tools. Never set
# this anywhere a second person can reach: `principal()` fails closed precisely so an
# unauthenticated caller is nobody, and this makes it somebody.
# CONTINUITY_DEV_PRINCIPAL=you@example.com
