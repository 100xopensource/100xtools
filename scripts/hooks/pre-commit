#!/usr/bin/env bash
# Pre-commit gate. Enable once with:
#
#     git config core.hooksPath scripts/hooks
#
# Runs the whole CI suite plus a leak sweep, in about two seconds. Everything here is
# cheap, so nothing is conditional on which files you staged — a check that decides for
# itself whether to run is a check that silently stops running.
#
# `git commit --no-verify` skips it. That is deliberate: a hook you cannot bypass is a hook
# people disable permanently.
set -uo pipefail

fail=0
step() { printf "  %-34s" "$1"; }
ok()   { printf "ok\n"; }
bad()  { printf "FAIL\n"; fail=1; }

echo "pre-commit"

# ── 0. An interpreter at the repo's floor ────────────────────────────────────────
# The floor is 3.11 and the macOS system `python3` is 3.9, so a bare `python3` here
# failed every python step on a stock Mac — the static check refused to start and six
# engine tests errored on `X | None` annotations. Both looked like the commit's fault
# and neither was, which is the worst kind of gate: one that blocks correct work and
# points somewhere else.
PY_CMD=""
for candidate in python3.14 python3.13 python3.12 python3.11 python3; do
  if command -v "$candidate" >/dev/null 2>&1 &&
     "$candidate" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 11) else 1)' \
       >/dev/null 2>&1; then
    PY_CMD="$candidate"
    break
  fi
done
if [ -z "$PY_CMD" ] && ! command -v uv >/dev/null 2>&1; then
  echo "  no python >= 3.11 and no uv on PATH — the repo's floor is 3.11"
  echo "  install one, or 'git commit --no-verify' to bypass."
  exit 1
fi

# One word or several: uv needs four, so this is a function rather than a variable.
# Arrays would be cleaner and are not safe under `set -u` in the bash 3.2 that ships
# with macOS.
py() {
  if [ -n "$PY_CMD" ]; then
    "$PY_CMD" "$@"
  else
    uv run --python 3.11 --no-project python "$@"
  fi
}
printf "  %-34s%s\n" "python" "${PY_CMD:-uv run --python 3.11}"

# ── 1. Leak sweep ────────────────────────────────────────────────────────────────
# First because it is the only failure here that cannot be undone: once a secret or an
# internal reference is in git history, removing it is a rewrite, not a revert. Scans the
# STAGED blob rather than the working tree — those differ, and the staged one is what ships.
#
# Only generic secret shapes live here. Organisation-specific terms — customer names,
# internal hostnames, ticket prefixes — go in leak-patterns.local, which is gitignored,
# because a public list of the names you are hiding publishes them. Same reason
# test_lint.py assembles its secret fixtures at run time.
step "no secrets or internal refs"
PATTERNS='AKIA[0-9A-Z]{16}|ASIA[0-9A-Z]{16}|ghp_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{22,}'
PATTERNS="$PATTERNS"'|xox[baprs]-[A-Za-z0-9-]{10,}|sk-[A-Za-z0-9]{32,}|AIza[0-9A-Za-z_-]{35}'
PATTERNS="$PATTERNS"'|BEGIN [A-Z ]*PRIVATE KEY'

local_patterns="$(dirname "$0")/leak-patterns.local"
if [ -f "$local_patterns" ]; then
  while IFS= read -r line; do
    case "$line" in ''|'#'*) continue ;; esac
    PATTERNS="$PATTERNS|$line"
  done < "$local_patterns"
fi

staged=$(git diff --cached --name-only --diff-filter=ACM)
leaks=""
if [ -n "$staged" ]; then
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    # Vendored third-party trees are not ours and were reviewed at import.
    case "$f" in examples/*/vendor/*) continue ;; esac
    hit=$(git show ":$f" 2>/dev/null | grep -InEo "$PATTERNS" | head -3)
    [ -n "$hit" ] && leaks="${leaks}\n    $f: $(echo "$hit" | tr '\n' ' ')"
  done <<< "$staged"
fi
if [ -n "$leaks" ]; then bad; printf "%b\n" "$leaks"; else ok; fi

# ── 2. Manifests ─────────────────────────────────────────────────────────────────
step "manifests parse"
if for f in .claude-plugin/marketplace.json plugins/*/.claude-plugin/plugin.json; do
     py -c "import json,sys; json.load(open(sys.argv[1]))" "$f" || exit 1
   done >/dev/null 2>&1; then ok; else bad; fi

# ── 3. Docs bundle ───────────────────────────────────────────────────────────────
step "docs bundle"
docs_out=$(py scripts/check_docs.py 2>&1) && ok || { bad; echo "$docs_out" | sed 's/^/    /'; }

# ── 4. Static: this repo's own plugins must stay at 1.00 ─────────────────────────
step "own plugins score 1.00"
static_out=$(py plugins/100xeval/skills/100xeval/scripts/run.py eval --static-only 2>&1)
if [ $? -ne 0 ] || echo "$static_out" | grep -qE "design_score 0\."; then
  bad; echo "$static_out" | grep -E "design_score|^- .*\[" | sed 's/^/    /'
else ok; fi

# ── 5. Engine tests ──────────────────────────────────────────────────────────────
step "engine tests"
# Both suites, because CI matrixes over both — a hook that checks one of them reports
# green on a change that breaks the other.
test_out=""
for suite in plugins/100xeval/skills/100xeval plugins/100x-continuity; do
  suite_out=$(cd "$suite" && PYTHONPATH=scripts \
    py -m unittest discover -s tests -p 'test_*.py' 2>&1) \
    || test_out="${test_out}${suite}\n${suite_out}\n"
done
if [ -z "$test_out" ]; then ok
else bad; printf "%b" "$test_out" | grep -E "^(FAIL|ERROR):|AssertionError|^plugins/" | head -6 | sed 's/^/    /'
fi

if [ "$fail" -ne 0 ]; then
  echo
  echo "commit blocked. fix the above, or 'git commit --no-verify' to bypass."
  exit 1
fi
exit 0
